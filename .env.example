# Snowflake connection (references ~/.snowflake/connections.toml entry)
SNOWFLAKE_CONNECTION_NAME=

# Snowflake object names
DATABASE_NAME=TSHO_SWT_TOKYO_26
WAREHOUSE_NAME=TSHO_WH_XL

# Optional: Override default fraud ratio for synthetic data (default: 0.03)
# FRAUD_RATIO=0.03

# Optional: Dynamic Table target lag (default: 1 hour)
# TARGET_LAG_MINUTES=60

# Optional: Snowflake account URL for external lineage API (demo1)
# SNOWFLAKE_ACCOUNT_URL=https://MYACCOUNT.snowflakecomputing.com
# SNOWFLAKE_PAT=  # Never commit actual tokens
